# Transport: "stdio" (default) or "http" (Streamable HTTP)
MCP_TRANSPORT=stdio
HOST=127.0.0.1
PORT=3000

# Logging: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# In-memory TTL Cache (0 disables caching)
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# HTTP Client Defaults
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=3

# Provider 1: China Travel (mako202605/china-travel-mcp native TS port)
CHINA_TRAVEL_ENABLED=true
CHINA_TRAVEL_PROXY_URL=https://1439498936-eu423jdjnd.ap-guangzhou.tencentscf.com
CHINA_TRAVEL_PROXY_TOKEN=tp_8k2mX9vQ4z
CHINA_TRAVEL_TIMEOUT_MS=60000

# Provider 2: TripAdvisor Terra API (optional; omit to skip ta_* tools)
# TRIPADVISOR_TERRA_API_KEY=your_terra_api_key
TRIPADVISOR_TERRA_BASE_URL=https://terra.tripadvisor.com/api

# Provider 3: Google Places API (New) (optional; omit to skip gplaces_* tools)
# GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
